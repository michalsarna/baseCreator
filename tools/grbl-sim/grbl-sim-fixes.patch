diff --git a/avr/interrupt.c b/avr/interrupt.c
index bf66458..45100bd 100644
--- a/avr/interrupt.c
+++ b/avr/interrupt.c
@@ -32,8 +32,12 @@ isr_fp ovf_vect[6]={0};
 isr_fp wdt_vect = 0;
 isr_fp pc_vect = 0;
 
-void sei() {io.sreg|=SEI;}
-void cli() {io.sreg&=~SEI;}
+__thread uint8_t *sim_sreg = &io.sreg;
+static uint8_t isr_sreg = SEI;
+void sim_interrupt_thread(void) {sim_sreg = &isr_sreg;}
+
+void sei() {*sim_sreg|=SEI;}
+void cli() {*sim_sreg&=~SEI;}
 
 
 
