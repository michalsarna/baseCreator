diff --git a/avr/io.h b/avr/io.h
index 5dea8c4..e34d2c5 100644
--- a/avr/io.h
+++ b/avr/io.h
@@ -223,7 +223,11 @@ volatile extern io_sim_t io;
 #define JTRF 4
 
 //Interrupt Status
-#define SREG io.sreg
+// Interrupts run on the simulator thread, concurrently with grbl's main loop. Each thread has its own SREG (see
+// interrupt.c) so an ISR's `sreg = SREG; cli(); ... SREG = sreg;` cannot interleave with the same pattern in the main
+// loop and leave interrupts disabled for good. Only the main thread's I flag (io.sreg) gates the interrupts.
+extern __thread uint8_t *sim_sreg;
+#define SREG (*sim_sreg)
 
 
 
