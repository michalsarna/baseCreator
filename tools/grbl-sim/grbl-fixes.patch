   cli();
-  sys_rt_exec_motion_override |= (mask);
+  __atomic_or_fetch(&sys_rt_exec_motion_override, (mask), __ATOMIC_SEQ_CST); // grbl-sim: cli() does not stop the interrupt thread
   SREG = sreg;
 }
 
 void system_set_exec_accessory_override_flag(uint8_t mask) {
   uint8_t sreg = SREG;
   cli();
-  sys_rt_exec_accessory_override |= (mask);
+  __atomic_or_fetch(&sys_rt_exec_accessory_override, (mask), __ATOMIC_SEQ_CST); // grbl-sim: cli() does not stop the interrupt thread
