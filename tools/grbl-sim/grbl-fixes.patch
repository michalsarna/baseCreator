+  __atomic_and_fetch(&sys_rt_exec_state, ~(mask), __ATOMIC_SEQ_CST); // grbl-sim: cli() does not stop the interrupt thread
   SREG = sreg;
 }
 
@@ -384,14 +384,14 @@ void system_clear_exec_alarm() {
