--- a/grbl/system.c
+++ b/grbl/system.c
@@ -356,14 +356,14 @@ uint8_t system_check_travel_limits(float *target)
 void system_set_exec_state_flag(uint8_t mask) {
   uint8_t sreg = SREG;
   cli();
-  sys_rt_exec_state |= (mask);
+  __atomic_or_fetch(&sys_rt_exec_state, (mask), __ATOMIC_SEQ_CST); // grbl-sim: cli() does not stop the interrupt thread
   SREG = sreg;
 }
 
 void system_clear_exec_state_flag(uint8_t mask) {
