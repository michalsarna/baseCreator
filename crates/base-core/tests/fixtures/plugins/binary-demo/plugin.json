{
  "format": 1,
  "id": "binary-demo",
  "name": "Binary importer demo",
  "version": "1.0.0",
  "author": "baseCreator tests",
  "license": "MIT",
  "description": "A binary importer with a form, a form made from the file, and a union of triangles. Used by the tests.",
  "importers": [
